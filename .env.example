# Copy this file to .env and add your Gemini API keys.
# Several keys, separated by commas, are pooled: each plan starts on the
# next key, and a key that hits its rate limit rests while the others
# carry on. Get keys at https://aistudio.google.com/apikey
#
# Warning: EXPO_PUBLIC_ values are built into the app's JavaScript, so
# anyone with the app can read them. Use these for testing only, and
# never set them in a public deployment (such as Vercel).
EXPO_PUBLIC_GEMINI_API_KEYS=key1,key2,key3

# Optional: a model to try before the built-in list.
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
